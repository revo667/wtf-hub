{
  "name": "wtf-hub",
  "private": true,
  "version": "0.1.0",
  "description": "wtf hub — desktop project, terminal, and AI CLI manager",
  "author": "wtf hub",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n bridge,vite -c green,cyan \"npm run bridge\" \"vite --host 127.0.0.1 --port 43127\"",
    "bridge": "tsx server/bridge.ts",
    "build": "tsc -b && vite build && npm run electron:compile",
    "electron:compile": "esbuild electron/main.ts --bundle --platform=node --outfile=dist-electron/main.cjs --external:electron --external:node-pty --external:@xhayper/discord-rpc --format=cjs && esbuild electron/preload.ts --bundle --platform=node --outfile=dist-electron/preload.cjs --external:electron --format=cjs",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true",
    "electron:rebuild": "npx --yes @electron/rebuild -f -w node-pty -v 45.0.0",
    "electron:dev": "npm run electron:compile && concurrently -k -n vite,electron -c cyan,magenta \"vite --host 127.0.0.1 --port 43127\" \"wait-on http://127.0.0.1:43127 && VITE_DEV_SERVER_URL=http://127.0.0.1:43127 electron .\"",
    "electron:attach": "npm run electron:compile && VITE_DEV_SERVER_URL=http://127.0.0.1:43127 electron .",
    "start": "npm run electron:dev",
    "lint": "oxlint",
    "preview": "vite preview --host 127.0.0.1 --port 43127"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.2.8",
    "@lezer/highlight": "^1.2.5",
    "@radix-ui/react-slot": "^1.2.4",
    "@xhayper/discord-rpc": "^1.5.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "node-pty": "^1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.27.0",
    "oxlint": "^1.88.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0",
    "wait-on": "^9.5.1"
  }
}
